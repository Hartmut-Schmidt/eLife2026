2a4711c2814c"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "\[Alpha]L", ",", "\[CapitalAlpha]L", ",", "\[Beta]L", ",", 
       "\[CapitalBeta]L"}], "]"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "gL"}], "=", 
    RowBox[{"24", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "12"}]]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Weber", " ", "et", " ", 
      RowBox[{"al", "."}]}], ",", " ", 
     RowBox[{"Nat", " ", "Neurosci"}], ",", " ", "2010"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Alpha]L", "=", 
    RowBox[{"0.427", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"x0", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalAlpha]L", "=", 
    RowBox[{"0.15", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"\[Alpha]", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Beta]L", "=", 
    RowBox[{"0.216", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "    ", 
   RowBox[{"(*", 
    RowBox[{"y0", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalBeta]L", "=", 
    RowBox[{"0.24", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "     ", 
   RowBox[{"(*", 
    RowBox[{"\[Beta]", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"\[Delta]", "=", 
    RowBox[{"1.39", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"\[Gamma]", "=", 
    RowBox[{"0.021", "*", 
     SuperscriptBox["10", "3"]}]}], ";", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"kLa", "=", 
    RowBox[{"328.8", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"kx", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"kLb", "=", 
    RowBox[{"9.04", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"ky", " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"u0", "=", 
    RowBox[{"\[Alpha]L", "*", 
     RowBox[{"\[Delta]", "/", "\[Gamma]"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"w0", "=", 
    RowBox[{"\[Beta]L", "*", 
     RowBox[{"\[CapitalBeta]L", "/", "\[CapitalAlpha]L"}]}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"alphaL", "=", 
    RowBox[{"\[Alpha]L", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"Vm", "/", "kLa"}], "]"}]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"x", 
     RowBox[{"(", "V", ")"}], " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"betaL", "=", 
    RowBox[{"\[Beta]L", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Vm"}], "/", "kLb"}], "]"}]}]}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"y", 
     RowBox[{"(", "V", ")"}], " ", "in", " ", "Beyl", " ", "et", " ", 
     RowBox[{"al", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"uL", "=", 
    RowBox[{"u0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"Vm", "/", "kLa"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"wL", "=", 
    RowBox[{"w0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Vm"}], "/", "kLb"}], "]"}]}]}], ";", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"LChannel", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LCh0", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LCh1", "[", "0", "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LChOpen", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LChD", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh0", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"LCh0", "[", "t", "]"}]}], "*", "alphaL"}], "+", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "betaL"}], "+", 
        RowBox[{
         RowBox[{"LChD", "[", "t", "]"}], "*", "\[Delta]"}]}]}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"LCh0", "[", "t", "]"}]}], "*", "\[Gamma]"}], "*)"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh1", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"+", 
          RowBox[{"LCh0", "[", "t", "]"}]}], "*", "alphaL"}], "-", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "betaL"}], "-", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "+", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LChOpen", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "-", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}], "-", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "wL"}], "+", 
        RowBox[{
         RowBox[{"LChD", "[", "t", "]"}], "*", "uL"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LChD", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "wL"}], "-", 
        RowBox[{
         RowBox[{"LChD", "[", "t", "]"}], "*", "uL"}], "-", 
        RowBox[{
         RowBox[{"LChD", "[", "t", "]"}], "*", "\[Delta]"}]}]}]}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{"LCh0", "[", "t", "]"}]}], "*", "\[Gamma]"}], "*)"}], "}"}]}],
    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{"VarsL", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"LCh0", ",", "LCh1", ",", "LChOpen", ",", "LChD"}], "}"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "solL"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{"LChannel", ",", "VarsL", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "TimeWindow"}], "}"}], ",", 
         RowBox[{"MaxStepSize", "\[Rule]", "0.001"}]}], "]"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"LChOpen", "[", "t", "]"}], "}"}], "/.", "solL"}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "0.004"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "plL1"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"12", " "}]], "*", "gL", 
             RowBox[{"(", 
              RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
             RowBox[{"{", 
              RowBox[{"LChOpen", "[", "t", "]"}], "}"}]}], "/.", "solL"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "0.004"}], "}"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", "LightGray"}]}], "]"}], "\n", 
        "InfluxL"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "F", " ", "Vb"}], ")"}]}], ")"}], "*", "gL", 
         "*", 
         RowBox[{"(", 
          RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
         RowBox[{"LChOpen", "[", "t", "]"}], "\[IndentingNewLine]", "InL"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "F", " ", "Vb"}], ")"}]}], ")"}], "*", "gL",
              "*", 
             RowBox[{"(", 
              RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
             RowBox[{"{", 
              RowBox[{"LChOpen", "[", "t", "]"}], "}"}]}], "/.", "solL"}], 
           "]"}], "\[IndentingNewLine]", 
          RowBox[{"Plot", "[", 
           RowBox[{"InL", ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "0.004"}], "}"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
          "\[IndentingNewLine]", "concL"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"-", "InL"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "0.004"}], "}"}]}], "]"}], 
           "\[IndentingNewLine]", "CaIonsL"}], "=", 
          RowBox[{"concL", "*", "NA", "*", "Vb"}]}]}]}]}]}]}]}]}], 
  "*)"}]], "Input",
