Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "\[Alpha]L", ",", "\[CapitalAlpha]L", ",", "\[Beta]L", ",", 
    "\[CapitalBeta]L"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gL", "=", 
    RowBox[{"9", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "12"}]]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"von", " ", "Wegner"}], " ", "&"}], " ", "Fink"}], ",", " ", 
    RowBox[{"Eur", " ", "Biophys", " ", "J"}], ",", " ", "2010."}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]L", "=", 
   RowBox[{"0.427", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalAlpha]L", "=", 
    RowBox[{"0.15", "*", 
     SuperscriptBox["10", "3"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]L", "=", 
   RowBox[{"0.216", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalBeta]L", "=", 
    RowBox[{"0.24", "*", 
     SuperscriptBox["10", "3"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kLa", "=", 
   RowBox[{"328.8", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kLb", "=", 
    RowBox[{"9.04", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphaL", "=", 
   RowBox[{"\[Alpha]L", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"Vm", "/", "kLa"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betaL", "=", 
    RowBox[{"\[Beta]L", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Vm"}], "/", "kLb"}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LChannel", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LCh0", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LCh1", "[", "0", "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LChOpen", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh0", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"LCh0", "[", "t", "]"}]}], "*", "alphaL"}], "+", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "betaL"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh1", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"LCh0", "'"}], "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "+", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LChOpen", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "-", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VarsL", ":=", 
   RowBox[{"{", 
    RowBox[{"LCh0", ",", "LCh1", ",", "LChOpen"}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solL", ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"LChannel", ",", "VarsL", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TimeWindow"}], "}"}], ",", 
     RowBox[{"MaxStepSize", "\[Rule]", "0.001"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"LChOpen", "[", "t", "]"}], "}"}], "/.", "solL"}], "]"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"APN", "*", "ISI"}]}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plL", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"12", " "}]], "*", "gL", 
        RowBox[{"(", 
         RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
        RowBox[{"{", 
         RowBox[{"LChOpen", "[", "t", "]"}], "}"}]}], "/.", "solL"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"APN", "*", "ISI"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "0.15"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Gray"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{"InfluxL", ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "F", " ", "Vb"}], ")"}]}], ")"}], "*", "gL", "*", 
   RowBox[{"(", 
    RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
   RowBox[{"LChOpen", "[", "t", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"InL", ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "F", " ", "Vb"}], ")"}]}], ")"}], "*", "gL", "*", 
     RowBox[{"(", 
      RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
     RowBox[{"{", 
      RowBox[{"LChOpen", "[", "t", "]"}], "}"}]}], "/.", "solL"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"InL", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "0.02"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"concL", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"-", "InL"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "0.02"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"CaIonsL", "=", 
  RowBox[{"concL", "*", "NA", "*", "Vb"}]}]}], "Input",
