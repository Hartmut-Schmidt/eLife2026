Cell[TextData[{
 "Last update: HS April 2025: \n\n",
 StyleBox["Status:\t \nInflux via different Cav driven by AP waveform with \
Unitstep function\nBuffering by cooperative CR and CR B5 with FF, ATP, EGTA \
or BAPTA, slow and fast endogenous buffers with estimted kinetics \n",
  FontColor->RGBColor[0, 0, 1]],
 "\n",
