    RowBox[{"9.", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "12"}]]}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"von", " ", "Wegner"}], " ", "&"}], " ", "Fink"}], ",", " ", 
    RowBox[{"Eur", " ", "Biophys", " ", "J"}], ",", " ", "2010."}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]L", "=", 
   RowBox[{"0.427", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalAlpha]L", "=", 
    RowBox[{"0.15", "*", 
     SuperscriptBox["10", "3"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]L", "=", 
   RowBox[{"0.216", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalBeta]L", "=", 
    RowBox[{"0.24", "*", 
     SuperscriptBox["10", "3"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kLa", "=", 
   RowBox[{"328.8", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kLb", "=", 
    RowBox[{"9.04", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphaL", "=", 
   RowBox[{"\[Alpha]L", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"Vm", "/", "kLa"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betaL", "=", 
    RowBox[{"\[Beta]L", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Vm"}], "/", "kLb"}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LChannel", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LCh0", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LCh1", "[", "0", "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LChOpen", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh0", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"LCh0", "[", "t", "]"}]}], "*", "alphaL"}], "+", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "betaL"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh1", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"LCh0", "'"}], "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "+", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LChOpen", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "-", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VarsL", ":=", 
   RowBox[{"{", 
    RowBox[{"LCh0", ",", "LCh1", ",", "LChOpen"}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solL", ":=", 
   RowBox[{"NDSolve", "[", 
