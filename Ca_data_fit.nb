 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"VarsL", ",", "LChannel", ",", "solL"}], "]"}], 
      "\[IndentingNewLine]", "gL"}], "=", 
