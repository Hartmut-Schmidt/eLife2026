Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LChannel", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LCh0", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LCh1", "[", "0", "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LChOpen", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh0", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"LCh0", "[", "t", "]"}]}], "*", "alphaL"}], "+", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "betaL"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LCh1", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"LCh0", "'"}], "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "+", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LChOpen", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"LCh1", "[", "t", "]"}], "*", "\[CapitalAlpha]L"}], "-", 
        RowBox[{
         RowBox[{"LChOpen", "[", "t", "]"}], "*", "\[CapitalBeta]L"}]}]}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VarsL", ":=", 
   RowBox[{"{", 
    RowBox[{"LCh0", ",", "LCh1", ",", "LChOpen"}], "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solL", ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"LChannel", ",", "VarsL", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "TimeWindow"}], "}"}], ",", 
     RowBox[{"MaxStepSize", "\[Rule]", "0.001"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"LChOpen", "[", "t", "]"}], "}"}], "/.", "solL"}], "]"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TimeWindow"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"plL", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["10", 
        RowBox[{"12", " "}]], "*", "gL", 
       RowBox[{"(", 
        RowBox[{"Vm", "-", "ECa"}], ")"}], "*", 
       RowBox[{"{", 
        RowBox[{"LChOpen", "[", "t", "]"}], "}"}]}], "/.", "solL"}], "]"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TimeWindow"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "0.15"}]}], "}"}]}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", "Gray"}]}], "]"}]}]}], "Input",
