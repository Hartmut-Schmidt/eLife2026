Cell[TextData[{
 "Last update: HS Jan. 2018: \nUse according to settings determined by Ca \
data fit\n",
 StyleBox["Status:\t \nInflux via different Cav driven by AP waveform; \
multiple APs with unitstep function\nBuffering by cooperative CR and CR B5 \
with FF, ATP, EGTA or BAPTA, slow and fast endogenous buffers with estimted \
kinetics \nLou Sensor & B\[ODoubleDot]hme Sensor & Kochubey Sensors for \
different age groups",
  FontColor->RGBColor[0, 0, 1]],
 "\n",
 StyleBox["Concentrations in mol/m3 (i.e. factor 10^-3 gives mol/l)",
  FontColor->RGBColor[0, 0, 1]]
}], "Subsubsection",
