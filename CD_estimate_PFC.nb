Cell[TextData[{
 "Last update: HS Aug. 2025, for PFC coupling project: \nUse according to \
settings determined by Ca data fit\n",
 StyleBox["Status:\t \nInflux via different Cav driven by AP waveform; \
multiple APs with unitstep function\nBuffering by cooperative CR and CR B5 \
with FF, ATP, EGTA or BAPTA, slow and fast endogenous buffers with estimted \
kinetics \nNew Syt1 sensor models instead of Syt2 models",
  FontColor->RGBColor[0, 0, 1]],
 "\n",
 StyleBox["Concentrations in mol/m3 (i.e. factor 10^-3 gives mol/l or mol/l * \
10^3 = mol/m3)",
  FontColor->RGBColor[0, 0, 1]]
}], "Subsubsection",
