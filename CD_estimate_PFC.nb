Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"Vm", ",", "startT", ",", "taud", ",", "taur"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startT", "=", 
   RowBox[{"0.1", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"taur", "=", 
    RowBox[{"0.1", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"longAP", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"taud", "=", 
      RowBox[{"0.4", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"taud", "=", 
      RowBox[{"0.2", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vm", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"UnitStep", "[", 
         RowBox[{"t", "-", "i"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"t", "-", "i"}], ")"}]}], "/", "taud"}], "]"}], "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"t", "-", "i"}], ")"}]}], "/", "taur"}], "]"}]}], 
         ")"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "startT", ",", 
        RowBox[{"startT", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"APN", "-", "1"}], ")"}], "*", "ISI"}]}], ",", "ISI"}], 
       "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"longAP", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Vm", "=", 
      RowBox[{
       RowBox[{"0.25", "*", "Vm"}], "-", "0.08"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Vm", "=", 
      RowBox[{
       RowBox[{"0.47", "*", "Vm"}], "-", "0.08"}]}]}], "]"}], ";"}], 
